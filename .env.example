# Pick ONE provider, or leave both blank to run in retrieval-only mode.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Optional overrides
# LLM_PROVIDER=auto              # auto | openai | groq | none
# EMBEDDING_BACKEND=auto         # auto | sentence-transformers | tfidf
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.1-8b-instant
